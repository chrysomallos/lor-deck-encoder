{
  "name": "lor-deck-encoder",
  "version": "3.0.1",
  "description": "Legends of Runeterra Deck Encoder",
  "author": "Chrysomallos",
  "repository": {
    "type": "git",
    "url": "https://github.com/chrysomallos/lor-deck-encoder.git"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "exports": "./index.mjs",
  "types": "./index.d.mts",
  "files": [
    "index.mjs",
    "index.d.mts",
    "index.d.mts.map",
    "cli.mjs",
    "fill-cache.mjs",
    "src/",
    "utils/"
  ],
  "dependencies": {
    "camelcase": "^10.0.0",
    "json-stringify-pretty-compact": "^4.0.0",
    "minimist": "^1.2.8",
    "object-hash": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-syntax-import-assertions": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-mocha": "^12.0.2",
    "globals": "^17.14.0",
    "mocha": "^12.0.3",
    "mocha-ctrf-json-reporter": "^0.2.0",
    "nano-benchmark": "^1.3.0",
    "quibble": "^0.13.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "cli": "node ./cli.mjs",
    "test-ci": "mocha --reporter mocha-ctrf-json-reporter ./test/unit/*.spec.mjs",
    "test-unit": "mocha ./test/unit/*.spec.mjs",
    "test-lint": "eslint src/**.mjs utils/**.mjs",
    "test-coverage": "c8 mocha ./test/unit/*.spec.mjs",
    "test-performance": "mocha ./test/performance/*.perf.mjs",
    "nano-benchmark": "npx nano-bench ./benchmark/decode-large.mjs;npx nano-bench ./benchmark/decode-small.mjs;npx nano-bench ./benchmark/var-int.mjs",
    "clean-types": "node -e \"const fs = require('node:fs'); for (const f of fs.globSync(['index.d.mts*', 'src/*.d.mts*', 'utils/*.d.mts*'])) fs.rmSync(f)\"",
    "build-types": "yarn clean-types && tsc",
    "postinstall": "node ./fill-cache.mjs"
  }
}
