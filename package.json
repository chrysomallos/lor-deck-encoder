{
  "name": "lor-deck-encoder",
  "version": "3.0.0",
  "description": "Legends of Runeterra Deck Encoder",
  "author": "Chrysomallos",
  "repository": {
    "type": "git",
    "url": "https://github.com/chrysomallos/lor-deck-encoder.git"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "exports": "./index.mjs",
  "types": "./index.d.mts",
  "dependencies": {
    "camelcase": "^9.0.0",
    "json-stringify-pretty-compact": "^4.0.0",
    "minimist": "^1.2.8",
    "object-hash": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.9",
    "@babel/plugin-syntax-import-assertions": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-jsdoc": "^65.1.0",
    "eslint-plugin-mocha": "^12.0.2",
    "globals": "^17.13.0",
    "mocha": "^12.0.3",
    "mocha-ctrf-json-reporter": "^0.1.0",
    "nano-benchmark": "^1.3.0",
    "quibble": "^0.11.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "cli": "node ./cli.mjs",
    "test:unit": "mocha ./test/unit/*.spec.mjs",
    "test:performance": "mocha ./test/performance/*.perf.mjs",
    "test:ci": "mocha --reporter mocha-ctrf-json-reporter ./test/unit/*.spec.mjs",
    "test:coverage": "c8 mocha ./test/unit/*.spec.mjs",
    "build:lint": "eslint src/**.mjs utils/**.mjs",
    "build:types": "npx -p typescript tsc",
    "benchmark:large": "npx nano-bench ./benchmark/decode-large.mjs",
    "benchmark:small": "npx nano-bench ./benchmark/decode-small.mjs",
    "benchmark:var-int": "npx nano-bench ./benchmark/var-int.mjs"
  }
}
